# Flask / Render
PORT=10000
FLASK_HOST=0.0.0.0
LOG_LEVEL=INFO
POLLING_INTERVAL_SECONDS=10

# Google Sheets
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/1VBdahTl8s-qzGszqYCm2wrDw0IKC9QoGF-dRLej-o7o/edit?usp=sharing
GOOGLE_WORKSHEET_NAME=Sheet1
YOUTUBE_WORKSHEET_NAME=Sheet2

# Google Service Account credentials.
# Render에서는 JSON 파일 전체를 한 줄 문자열로 만들어 아래 값에 넣는 방식을 권장합니다.
# 예: python -c "import json; print(json.dumps(json.load(open('service-account.json'))))"
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"YOUR_PROJECT_ID","private_key_id":"YOUR_PRIVATE_KEY_ID","private_key":"-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n","client_email":"YOUR_SERVICE_ACCOUNT_EMAIL","client_id":"YOUR_CLIENT_ID","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"YOUR_CERT_URL","universe_domain":"googleapis.com"}

# 로컬 파일 방식이 더 편하면 GOOGLE_SERVICE_ACCOUNT_JSON 대신 아래 값을 사용하세요.
# GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json

# Apify / Instagram
APIFY_TOKEN=apify_api_YOUR_TOKEN
APIFY_ACTOR_ID=apify/instagram-scraper
APIFY_RESULTS_LIMIT=12
APIFY_TIMEOUT_SECONDS=300

# Gemini AI
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-1.5-flash

# YouTube Data API
YOUTUBE_API_KEY=YOUR_YOUTUBE_DATA_API_KEY
YOUTUBE_RECENT_VIDEO_LIMIT=30
YOUTUBE_REQUEST_TIMEOUT_SECONDS=20
